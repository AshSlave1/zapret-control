<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>ZapretControl</AssemblyName>
    <AssemblyTitle>ZAPRET//CTRL</AssemblyTitle>
    <RootNamespace>ZapretControl</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>Zapret Control</Authors>
    <Product>ZAPRET//CTRL</Product>
    <Description>ZAPRET//CTRL 1.1 — cyberpunk control panel for zapret DPI bypass</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

</Project>
