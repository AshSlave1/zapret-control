<Window x:Class="ZapretControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ZapretControl.Converters"
        xmlns:core="clr-namespace:ZapretControl.Core"
        Title="ZAPRET//CTRL"
        Width="1180" Height="780"
        MinWidth="1000" MinHeight="640"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- ===================== BACKGROUND ===================== -->
        <Grid>
            <Image x:Name="WallpaperImage" Stretch="UniformToFill" Opacity="0.30" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D907040A" Offset="0" />
                        <GradientStop Color="#B30B0610" Offset="0.5" />
                        <GradientStop Color="#D907040A" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Ellipse Width="760" Height="760"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-300,-360,0,0"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3DFF2D6F" Offset="0" />
                        <GradientStop Color="#00FF2D6F" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="90" />
                </Ellipse.Effect>
            </Ellipse>

            <Rectangle x:Name="ScanlinesLayer" IsHitTestVisible="False" Opacity="0.05">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile"
                                  Viewport="0,0,1,4"
                                  ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#FF00E5FF">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,1,1" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ===================== CONTENT ===================== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Grid Grid.Row="0" Background="#6607040A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource NeonBrush}" Margin="0,0,8,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{StaticResource NeonColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="ZAPRET" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold" />
                    <TextBlock Text="//CTRL" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NeonBrush}" />
                    <TextBlock Text="DPI BYPASS CONSOLE" Style="{StaticResource MonoLabel}" FontSize="9" Margin="12,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Style="{StaticResource CaptionButton}" Click="Minimize_Click" />
                    <Button Content="□" Style="{StaticResource CaptionButton}" Click="Maximize_Click" />
                    <Button Content="✕" Style="{StaticResource CloseCaptionButton}" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- MAIN -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="#B30A050C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Text="ZAPRET" Style="{StaticResource H2}" FontSize="22" />
                            <TextBlock Text="//CONTROL" Style="{StaticResource H2}" FontSize="22" Foreground="{StaticResource NeonBrush}" Margin="0,-4,0,0" />
                            <TextBlock Text="DPI BYPASS CONSOLE" Style="{StaticResource MonoLabel}" Margin="0,6,0,0" />
                        </StackPanel>

                        <ListBox x:Name="NavList" Grid.Row="1" Style="{StaticResource NavListBox}"
                                 Margin="10,0" SelectedIndex="0" SelectionChanged="NavList_SelectionChanged">
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Grid.Column="1" Text="ОБЗОР" Style="{StaticResource MonoLabel}" FontSize="11"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Grid.Column="1" Text="СТРАТЕГИИ" Style="{StaticResource MonoLabel}" FontSize="11"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Grid.Column="1" Text="ДИАГНОСТИКА" Style="{StaticResource MonoLabel}" FontSize="11"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Grid.Column="1" Text="СПИСКИ" Style="{StaticResource MonoLabel}" FontSize="11"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Grid.Column="1" Text="ЖУРНАЛ" Style="{StaticResource MonoLabel}" FontSize="11"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Grid.Column="1" Text="НАСТРОЙКИ" Style="{StaticResource MonoLabel}" FontSize="11"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Grid>
                            </ListBoxItem>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="16,12,16,18">
                            <Border Style="{StaticResource CardTight}" Padding="12" Background="#99140A18">
                                <StackPanel>
                                    <TextBlock Text="СТАТУС" Style="{StaticResource MonoLabel}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="{Binding StatusColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource H3}" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActiveProfileName}" Style="{StaticResource SmallText}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="v1.1.0 · WINDOWS 10" Style="{StaticResource MonoLabel}" FontSize="9" Margin="2,12,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PAGES -->
                <TabControl x:Name="MainTabs" Grid.Column="1" Style="{StaticResource ContentOnlyTabControl}" SelectedIndex="0">

                    <!-- ===================== DASHBOARD ===================== -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:SmoothScrollBehavior.IsEnabled="True">
                            <StackPanel Margin="28,20,28,28">

                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="ОБЗОР" Style="{StaticResource H1}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="МИНИ-МОНИТОР" Style="{StaticResource GhostButton}"
                                                Padding="10,5" FontSize="10" Click="OpenMonitor_Click" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding ClockText}" Style="{StaticResource MonoLabel}"
                                                   VerticalAlignment="Center" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource CardGlow}" Padding="24" Margin="0,18,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding StatusBadgeBrush}" CornerRadius="4" Padding="8,3">
                                                    <TextBlock Text="{Binding StatusBadgeText}" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                               Foreground="{StaticResource NeonBrush}" />
                                                </Border>
                                                <Border Background="#22A08CA6" CornerRadius="4" Padding="8,3" Margin="8,0,0,0"
                                                        Visibility="{Binding IsExternalProcess, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="ВНЕШНИЙ ПРОЦЕСС" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                               Foreground="{StaticResource YellowBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource H1}" FontSize="34" Margin="0,14,0,0" />

                                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                <Button Content="{Binding ToggleButtonText}" Style="{StaticResource PrimaryButton}"
                                                        Click="ToggleBypass_Click" MinWidth="190" IsEnabled="{Binding CanToggle}"
                                                        PreviewMouseLeftButtonDown="StopHold_PreviewMouseLeftButtonDown"
                                                        PreviewMouseLeftButtonUp="StopHold_PreviewMouseLeftButtonUp" />
                                                <Button Content="СМЕНИТЬ СТРАТЕГИЮ" Style="{StaticResource GhostButton}"
                                                        Click="GoStrategies_Click" Margin="10,0,0,0" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding LockHint}" Style="{StaticResource SmallText}" Margin="0,10,0,0"
                                                       TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                                       Visibility="{Binding LockHint, Converter={StaticResource TextToVis}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Width="255" Margin="24,0,0,0">
                                            <TextBlock Text="ТЕКУЩАЯ СТРАТЕГИЯ" Style="{StaticResource MonoLabel}" />
                                            <TextBlock Text="{Binding ActiveProfileName}" Style="{StaticResource H2}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ActiveProfileDesync}" Style="{StaticResource SmallText}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                            <Border Style="{StaticResource SeparatorLine}" Margin="0,14" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="PID" Style="{StaticResource MonoLabel}" />
                                                <TextBlock Grid.Column="1" Text="{Binding PidText}" Style="{StaticResource MonoValue}" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="UPTIME" Style="{StaticResource MonoLabel}" />
                                                <TextBlock Grid.Column="1" Text="{Binding UptimeText}" Style="{StaticResource MonoValue}" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="GAME FILTER" Style="{StaticResource MonoLabel}" />
                                                <TextBlock Grid.Column="1" Text="{Binding GameFilterText}" Style="{StaticResource MonoValue}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <UniformGrid Columns="3" Margin="0,14,0,0">
                                    <Border Style="{StaticResource CardTight}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="WINDIVERT" Style="{StaticResource MonoLabel}" />
                                            <TextBlock Text="{Binding WinDivertStatus}" Style="{StaticResource H3}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding WinDivertDetail}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardTight}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="TCP TIMESTAMPS" Style="{StaticResource MonoLabel}" />
                                            <TextBlock Text="{Binding TimestampsStatus}" Style="{StaticResource H3}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardTight}">
                                        <StackPanel>
                                            <TextBlock Text="ПРОФИЛИ" Style="{StaticResource MonoLabel}" />
                                            <TextBlock Text="{Binding ProfilesCountText}" Style="{StaticResource H3}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding KnownGoodCountText}" Style="{StaticResource SmallText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="330" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="ЖУРНАЛ СОБЫТИЙ" Style="{StaticResource MonoLabel}" />
                                                <Button Content="ОТКРЫТЬ ЛОГ" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                        Padding="10,5" FontSize="10" Click="OpenLog_Click" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Logs}" Margin="0,10,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="62" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource MonoLabel}" FontSize="9" Margin="0,2,0,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ПОСЛЕДНИЙ ЗАМЕР" Style="{StaticResource MonoLabel}" />
                                            <TextBlock Text="YouTube CDN" Style="{StaticResource H3}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding LastSpeedText}" Style="{StaticResource SmallText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                            <Button Content="ЗАМЕРИТЬ" Style="{StaticResource GhostButton}" Margin="0,12,0,0"
                                                    Click="MeasureSpeed_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                            <TextBlock Text="{Binding SpeedHint}" Style="{StaticResource SmallText}" Margin="0,8,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding SpeedHint, Converter={StaticResource TextToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===================== STRATEGIES ===================== -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:SmoothScrollBehavior.IsEnabled="True">
                            <StackPanel Margin="28,20,28,28">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="СТРАТЕГИИ" Style="{StaticResource H1}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="ОБНОВИТЬ" Style="{StaticResource GhostButton}" Click="ReloadProfiles_Click" Margin="0,0,8,0" />
                                        <CheckBox x:Name="FavoritesOnlyCheck" Style="{StaticResource CheckBoxStyle}"
                                                  Content="★ ИЗБРАННЫЕ" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Click="FavoritesOnlyCheck_Click" />
                                        <Grid Width="260">
                                            <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}"
                                                     TextChanged="SearchBox_TextChanged" ToolTip="Поиск по названию или dpi-desync" />
                                            <TextBlock Text="ПОИСК"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyTextToVis}}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <ListBox ItemsSource="{Binding ProfilesView}" Style="{StaticResource PlainListBox}" Margin="0,16,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" FontSize="15" />
                                                            <Border Background="#22FF2D6F" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                                                    Visibility="{Binding IsKnownGood, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="ПРОВЕРЕНА" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                                           Foreground="{StaticResource NeonBrush}" />
                                                            </Border>
                                                            <Border Background="#22F2D06B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                                                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="РЕКОМЕНДОВАНА" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                                           Foreground="{StaticResource YellowBrush}" />
                                                            </Border>
                                                            <Border Background="#22FF3B5C" CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                                                                    ToolTip="{Binding WarningText}"
                                                                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="АГРЕССИВНАЯ" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                                           Foreground="{StaticResource DangerBrush}" />
                                                            </Border>
                                                            <Border Background="#2200E5FF" CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="ВЫБРАНА" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                                           Foreground="{StaticResource CyanBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DesyncSummary}" Style="{StaticResource MonoValue}"
                                                                   Foreground="{StaticResource CyanBrush}" Margin="0,8,0,0" />
                                                        <TextBlock Text="{Binding PortsSummary}" Style="{StaticResource SmallText}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <Button Content="{Binding FavoriteGlyph}" Style="{StaticResource IconButton}"
                                                                Click="ToggleFavorite_Click" Tag="{Binding}" ToolTip="В избранное"
                                                                Margin="0,0,8,0" />
                                                        <Button Content="ВЫБРАТЬ" Style="{StaticResource GhostButton}" Click="SelectProfile_Click"
                                                                Tag="{Binding}" IsEnabled="{Binding DataContext.CanApplyProfile, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <Button Content="ЗАПУСТИТЬ" Style="{StaticResource PrimaryButton}" Click="StartProfile_Click"
                                                                Tag="{Binding}" Margin="8,0,0,0" Padding="14,8"
                                                                IsEnabled="{Binding DataContext.CanStartProfile, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===================== DIAGNOSTICS ===================== -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:SmoothScrollBehavior.IsEnabled="True">
                            <StackPanel Margin="28,20,28,28">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="ДИАГНОСТИКА" Style="{StaticResource H1}"
                                                   ToolTip="Проверки только читают состояние и не останавливают обход." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="ПРОВЕРИТЬ" Style="{StaticResource PrimaryButton}" Click="RunDiagnostics_Click"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                        <Button Content="ЗАМЕРИТЬ СКОРОСТЬ" Style="{StaticResource GhostButton}" Click="MeasureSpeed_Click"
                                                Margin="8,0,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                        <Button Content="ЭКСПОРТ" Style="{StaticResource GhostButton}" Click="ExportReport_Click" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding LastDiagnosticsText}" Style="{StaticResource SmallText}" Margin="0,10,0,0" />

                                <ItemsControl ItemsSource="{Binding Checks}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardTight}" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                             VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" FontSize="12" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallText}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource MonoLabel}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ПРОВЕРКА САЙТА" Style="{StaticResource MonoLabel}" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SiteCheckBox" Style="{StaticResource InputBox}"
                                                     ToolTip="Домен или полный адрес" />
                                            <Button Grid.Column="1" Content="ПРОВЕРИТЬ" Style="{StaticResource PrimaryButton}"
                                                    Click="CheckSite_Click" Margin="8,0,0,0" Padding="16,8"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding SiteCheckSummary}" Style="{StaticResource H3}" FontSize="13"
                                                   Foreground="{Binding SiteCheckBrush}" Margin="0,10,0,0"
                                                   Visibility="{Binding SiteCheckSummary, Converter={StaticResource TextToVis}}" />
                                        <TextBlock Text="{Binding SiteCheckDetail}" Style="{StaticResource SmallText}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                    Visibility="{Binding SiteCheckCanAdd, Converter={StaticResource BoolToVis}}">
                                            <Button Content="В ОБЩИЙ СПИСОК" Style="{StaticResource GhostButton}"
                                                    Click="AddSiteToGeneral_Click" />
                                            <Button Content="В ИСКЛЮЧЕНИЯ" Style="{StaticResource GhostButton}"
                                                    Click="AddSiteToExclude_Click" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="ПРОЦЕСС WINWS" Style="{StaticResource MonoLabel}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="ДЕТАЛИ" Style="{StaticResource GhostButton}"
                                                        Padding="10,5" FontSize="10" Click="LoadProcessDetails_Click" />
                                                <Button Content="КОПИРОВАТЬ PID" Style="{StaticResource GhostButton}"
                                                        Padding="10,5" FontSize="10" Click="CopyPid_Click" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding ProcessDetailsText}" Style="{StaticResource MonoValue}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="ИСТОРИЯ СТАТУСОВ" Style="{StaticResource MonoLabel}" />
                                            <Button Content="ОТКРЫТЬ CSV" Style="{StaticResource GhostButton}"
                                                    Padding="10,5" FontSize="10" Click="OpenStatusHistory_Click"
                                                    HorizontalAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding StatusEvents}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource MonoLabel}" FontSize="9" Margin="0,2,0,0" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Summary}" FontSize="11" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallText}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="СКОРОСТЬ ПО ЗАМЕРАМ" Style="{StaticResource MonoLabel}"
                                                       ToolTip="YouTube измеряется через i.ytimg.com. Просадка только YouTube CDN при нормальном Cloudflare указывает на троттлинг." />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource CyanBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Cloudflare" Style="{StaticResource SmallText}" Margin="0,0,14,0" />
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource NeonBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="YouTube CDN" Style="{StaticResource SmallText}" />
                                            </StackPanel>
                                        </Grid>
                                        <Canvas x:Name="SpeedCanvas" Height="180" Margin="0,12,0,0"
                                                SizeChanged="SpeedCanvas_SizeChanged" ClipToBounds="True" />
                                        <Button Content="ОЧИСТИТЬ ИСТОРИЮ" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                Margin="0,8,0,0" Click="ClearSpeedHistory_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===================== LISTS ===================== -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:SmoothScrollBehavior.IsEnabled="True">
                            <StackPanel Margin="28,20,28,28">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="СПИСКИ" Style="{StaticResource H1}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="ОБНОВИТЬ" Style="{StaticResource GhostButton}" Click="ReloadLists_Click" Margin="0,0,8,0" />
                                        <Button Content="ПАПКА LISTS" Style="{StaticResource GhostButton}" Click="OpenListsFolder_Click" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="list-general-user.txt" Style="{StaticResource H3}" />
                                                <TextBlock Text="Домены · по одному на строку"
                                                           Style="{StaticResource SmallText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Content="СОХРАНИТЬ" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                    VerticalAlignment="Top" Click="SaveGeneralList_Click" />
                                        </Grid>
                                        <TextBox x:Name="GeneralListBox" Style="{StaticResource MonoInputBox}" Height="130" Margin="0,10,0,0"
                                                 AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto" />
                                        <TextBlock x:Name="GeneralListCount" Style="{StaticResource SmallText}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="list-exclude-user.txt" Style="{StaticResource H3}" />
                                                <TextBlock Text="Исключения · обход не применяется"
                                                           Style="{StaticResource SmallText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Content="СОХРАНИТЬ" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                    VerticalAlignment="Top" Click="SaveExcludeList_Click" />
                                        </Grid>
                                        <TextBox x:Name="ExcludeListBox" Style="{StaticResource MonoInputBox}" Height="110" Margin="0,10,0,0"
                                                 AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto" />
                                        <TextBlock x:Name="ExcludeListCount" Style="{StaticResource SmallText}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="ipset-exclude-user.txt" Style="{StaticResource H3}" />
                                                <TextBlock Text="IP/CIDR · по одному на строку" Style="{StaticResource SmallText}" />
                                            </StackPanel>
                                            <Button Content="СОХРАНИТЬ" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                    VerticalAlignment="Top" Click="SaveIpSetList_Click" />
                                        </Grid>
                                        <TextBox x:Name="IpSetListBox" Style="{StaticResource MonoInputBox}" Height="110" Margin="0,10,0,0"
                                                 AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto" />
                                        <TextBlock x:Name="IpSetListCount" Style="{StaticResource SmallText}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===================== LOG ===================== -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:SmoothScrollBehavior.IsEnabled="True">
                            <StackPanel Margin="28,20,28,28">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="ЖУРНАЛ" Style="{StaticResource H1}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="КОПИРОВАТЬ ВИДИМОЕ" Style="{StaticResource GhostButton}"
                                                Click="CopyVisibleLog_Click" Margin="0,0,8,0" />
                                        <Button Content="ЭКСПОРТ ОШИБОК" Style="{StaticResource GhostButton}"
                                                Click="ExportErrors_Click" Margin="0,0,8,0" />
                                        <Button Content="ОТКРЫТЬ ФАЙЛ" Style="{StaticResource GhostButton}"
                                                Click="OpenLog_Click" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="LogSearchBox" Style="{StaticResource InputBox}"
                                                 TextChanged="LogSearch_TextChanged" />
                                        <TextBlock Text="ПОИСК ПО ЖУРНАЛУ"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding Text, ElementName=LogSearchBox, Converter={StaticResource EmptyTextToVis}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <CheckBox x:Name="LogInfoCheck" Style="{StaticResource CheckBoxStyle}" Content="INFO"
                                                  IsChecked="True" Margin="0,0,10,0" Click="LogFilter_Click" />
                                        <CheckBox x:Name="LogWarnCheck" Style="{StaticResource CheckBoxStyle}" Content="WARN"
                                                  IsChecked="True" Margin="0,0,10,0" Click="LogFilter_Click" />
                                        <CheckBox x:Name="LogErrorCheck" Style="{StaticResource CheckBoxStyle}" Content="ERROR"
                                                  IsChecked="True" Margin="0,0,10,0" Click="LogFilter_Click" />
                                        <CheckBox x:Name="LogSuccessCheck" Style="{StaticResource CheckBoxStyle}" Content="OK"
                                                  IsChecked="True" Click="LogFilter_Click" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding LogView}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardTight}" Margin="0,0,0,6" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding FullTimeText}" Style="{StaticResource MonoLabel}"
                                                               FontSize="9" Margin="0,2,0,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
                                                    <Button Grid.Column="2" Content="⧉" Style="{StaticResource IconButton}"
                                                            Width="26" Height="24" Click="CopyLogEntry_Click" Tag="{Binding}"
                                                            ToolTip="Скопировать строку" Margin="8,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===================== SETTINGS ===================== -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:SmoothScrollBehavior.IsEnabled="True">
                            <StackPanel Margin="28,20,28,28">
                                <TextBlock Text="НАСТРОЙКИ" Style="{StaticResource H1}" />

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ПАПКА ZAPRET" Style="{StaticResource MonoLabel}" />
                                        <TextBlock Text="{Binding ZapretPathStatus}" Style="{StaticResource H3}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ZapretPathBox" Style="{StaticResource InputBox}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button Content="ОБЗОР" Style="{StaticResource GhostButton}" Click="BrowseZapret_Click" />
                                                <Button Content="ОПРЕДЕЛИТЬ" Style="{StaticResource GhostButton}" Click="DetectZapret_Click" Margin="6,0,0,0" />
                                                <Button Content="ПРИМЕНИТЬ" Style="{StaticResource PrimaryButton}" Click="ApplyPath_Click" Margin="6,0,0,0" Padding="14,8" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="ПРАВА" Style="{StaticResource MonoLabel}" />
                                            <TextBlock Text="{Binding ElevationText}" Style="{StaticResource H3}" Margin="0,4,0,0"
                                                       Foreground="{Binding ElevationBrush}" />
                                            <TextBlock Text="Нужны для запуска winws."
                                                       Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            <Button Content="ПЕРЕЗАПУСТИТЬ ОТ АДМИНИСТРАТОРА" Style="{StaticResource GhostButton}"
                                                    Click="RelaunchAdmin_Click" Margin="0,10,0,0"
                                                    Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVis}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="УПРАВЛЕНИЕ ПРОЦЕССАМИ" Style="{StaticResource MonoLabel}" />
                                            <TextBlock Text="{Binding ControlStateText}" Style="{StaticResource H3}" Margin="0,4,0,0"
                                                       Foreground="{Binding ControlStateBrush}" />
                                            <TextBlock Text="До закрытия приложения или автоблокировки."
                                                       Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            <Button Content="{Binding ControlButtonText}" Style="{StaticResource DangerButton}"
                                                    Click="UnlockControl_Click" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="СИСТЕМА" Style="{StaticResource MonoLabel}" />
                                        <CheckBox x:Name="AutostartCheck" Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                                  Click="AutostartCheck_Click" Content="Автозапуск при входе в Windows"
                                                  ToolTip="Задача Планировщика Windows с правами администратора" />
                                        <CheckBox x:Name="TrayCheck" Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                                  Click="TrayCheck_Click" Content="Сворачивать в трей при закрытии окна" />
                                        <CheckBox x:Name="AutoLockCheck" Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                                  Click="AutoLockCheck_Click" Content="Автоблокировать управление через 10 минут" />
                                        <CheckBox x:Name="LockOnMinimizeCheck" Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                                  Click="LockOnMinimizeCheck_Click" Content="Блокировать при сворачивании" />
                                        <CheckBox x:Name="NotificationsCheck" Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                                  Click="NotificationsCheck_Click" Content="Уведомления в трее" />
                                        <CheckBox x:Name="ScheduledTestsCheck" Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                                  Click="ScheduledTestsCheck_Click"
                                                  Content="Ночные замеры скорости: 20:00, 22:00, 00:00" />
                                        <TextBlock Text="Выход не останавливает обход." Style="{StaticResource SmallText}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="РЕЗЕРВНЫЕ КОПИИ" Style="{StaticResource MonoLabel}" />
                                        <TextBlock Text="config.json, списки и история замеров в одном zip."
                                                   Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="СОЗДАТЬ БЭКАП" Style="{StaticResource GhostButton}" Click="CreateBackup_Click" />
                                            <Button Content="ВОССТАНОВИТЬ" Style="{StaticResource GhostButton}" Click="RestoreBackup_Click" Margin="8,0,0,0" />
                                            <Button Content="ПАПКА БЭКАПОВ" Style="{StaticResource GhostButton}" Click="OpenBackupFolder_Click" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ОФОРМЛЕНИЕ" Style="{StaticResource MonoLabel}" />
                                        <CheckBox x:Name="WallpaperCheck" Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                                  Click="WallpaperCheck_Click" Content="Размытые обои рабочего стола как фон" />
                                        <CheckBox x:Name="ScanlinesCheck" Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                                  Click="ScanlinesCheck_Click" Content="Сканлайны и неоновые акценты" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="О ПРОГРАММЕ" Style="{StaticResource MonoLabel}" />
                                        <TextBlock Text="ZAPRET//CTRL" Style="{StaticResource H3}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding AppVersion}" Style="{StaticResource SmallText}" />
                                        <TextBlock Text="Неофициальный GUI для zapret. Не VPN, системные настройки не меняет."
                                                   Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <CheckBox x:Name="PortableCheck" Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                                  Click="PortableCheck_Click" Content="Портативный режим: данные рядом с exe" />
                                        <TextBlock Text="Переключение требует перезапуска приложения."
                                                   Style="{StaticResource SmallText}" Margin="0,6,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="ПАПКА ЛОГОВ" Style="{StaticResource GhostButton}" Click="OpenLogFolder_Click" />
                                            <Button Content="ПАПКА ДАННЫХ" Style="{StaticResource GhostButton}" Click="OpenDataFolder_Click" Margin="8,0,0,0" />
                                            <Button Content="ПАПКА ZAPRET" Style="{StaticResource GhostButton}" Click="OpenZapretFolder_Click" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
