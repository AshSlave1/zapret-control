<Window x:Class="ZapretControl.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZAPRET//CTRL MONITOR"
        Width="390" Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="Root"
            Background="#F00B0610"
            BorderBrush="#66FF2D6F"
            BorderThickness="1"
            CornerRadius="16"
            Padding="18"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#FF2D6F" BlurRadius="28" ShadowDepth="0" Opacity="0.28" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,9,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{Binding StatusColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="ZAPRET" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="//CTRL" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource NeonBrush}" />
                    <TextBlock Text="MONITOR" Style="{StaticResource MonoLabel}" FontSize="9" Margin="10,1,0,0" />
                </StackPanel>

                <Button Content="✕" Style="{StaticResource CaptionButton}"
                        HorizontalAlignment="Right" Width="30" Height="26" Click="Close_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <Border Background="{Binding StatusBadgeBrush}" CornerRadius="4" Padding="8,3"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding StatusBadgeText}" FontFamily="{StaticResource MonoFont}" FontSize="9"
                               Foreground="{StaticResource NeonBrush}" />
                </Border>
                <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource H1}" FontSize="28" Margin="0,10,0,0" />
                <TextBlock Text="{Binding ActiveProfileName}" Style="{StaticResource H2}" FontSize="16"
                           Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ActiveProfileDesync}" Style="{StaticResource SmallText}"
                           Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="PID" Style="{StaticResource MonoLabel}" />
                    <TextBlock Text="{Binding PidText}" Style="{StaticResource MonoValue}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="UPTIME" Style="{StaticResource MonoLabel}" />
                    <TextBlock Text="{Binding UptimeText}" Style="{StaticResource MonoValue}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3" Text="READ-ONLY · УПРАВЛЕНИЕ В ОСНОВНОМ ОКНЕ"
                       Style="{StaticResource MonoLabel}" FontSize="8" Margin="0,14,0,0" />
        </Grid>
    </Border>
</Window>
